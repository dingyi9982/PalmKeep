root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ets,ts,js,mjs,json,json5,md,xml,css,html,c,h,cpp,hpp}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,webp,ico,mp3,m4a,aac,wav,amr,flac,ogg,mp4,mov,so,har,hap,app}]
insert_final_newline = unset
trim_trailing_whitespace = unset
