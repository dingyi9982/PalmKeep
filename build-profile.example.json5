{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.0.1(21)",
        "runtimeOS": "HarmonyOS"
      },
      {
        "name": "localRelease",
        "signingConfig": "debug",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.0.1(21)",
        "runtimeOS": "HarmonyOS"
      },
      {
        "name": "debug",
        "signingConfig": "debug",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.0.1(21)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default", "localRelease"]
        },
        {
          "name": "debug",
          "applyToProducts": ["debug"]
        }
      ]
    }
  ]
}
