{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:entry_desc",
        "icon": "$media:launcher_icon_layered",
        "label": "$string:app_name",
        "startWindowIcon": "$media:launcher_icon_layered",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "backgroundModes": ["audioRecording"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "ShareReceiverAbility",
        "srcEntry": "./ets/entryability/ShareReceiverAbility.ets",
        "type": "share",
        "description": "$string:share_receiver_desc",
        "exported": true,
        "label": "$string:share_receiver_label",
        "icon": "$media:launcher_icon_layered",
        "skills": [
          {
            "actions": ["ohos.want.action.sendData", "ohos.want.action.sendMultipleData"],
            "uris": [
              { "scheme": "file", "utd": "general.text", "maxFileSupported": 1 },
              { "scheme": "file", "utd": "general.hyperlink", "maxFileSupported": 1 },
              { "scheme": "file", "utd": "general.image", "maxFileSupported": 50 },
              { "scheme": "file", "utd": "general.video", "maxFileSupported": 50 },
              { "scheme": "file", "utd": "general.audio", "maxFileSupported": 50 },
              { "scheme": "file", "utd": "general.file", "maxFileSupported": 50 },
              { "scheme": "file", "utd": "general.composite-object", "maxFileSupported": 50 },
              { "scheme": "file", "utd": "general.archive", "maxFileSupported": 50 },
              { "scheme": "file", "utd": "general.object", "maxFileSupported": 50 }
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.PRIVACY_WINDOW" },
      { "name": "ohos.permission.ACCESS_BIOMETRIC" },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:camera_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:background_recording_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      }
    ]
  }
}
